# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/candidate_screen?schema=public"

# Session secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# App URL (used for email links and invite URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com) — verified domain required for production
RESEND_API_KEY="re_..."
EMAIL_FROM="Talang Flow <hello@yourdomain.com>"

# Storage: "local" (default) or "r2"
# For browser uploads to R2, set a CORS policy on the bucket allowing PUT from your app origin
# (e.g. https://talangflow.com) with AllowedHeaders: Content-Type
STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="candidate-screen-media"

# Dev only: skip database + login to preview all screens (never use in production)
DEV_BYPASS_AUTH=true

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  ADMIN
  RECRUITER
}

enum InterviewStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CandidateStage {
  TO_REVIEW
  SHORTLISTED
  INTERVIEWING
  PASSED
}

enum CandidateDecision {
  ADVANCE
  MAYBE
  PASS
}

enum InviteStatus {
  PENDING
  STARTED
  COMPLETED
  EXPIRED
}

enum JobStatus {
  OPEN
  DRAFT
  CLOSED
}

enum ApplicationStage {
  APPLIED
  INVITED
  INTERVIEWED
  PASSED
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     WorkspaceMember[]
  interviews      Interview[]         @relation("InterviewOwner")
  jobs            Job[]               @relation("JobOwner")
  workspaceInvites WorkspaceInvite[]  @relation("InvitedBy")
}

model Workspace {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  careersUrl String?
  logoUrl    String?
  accentColor String  @default("#1C6B47")
  /// Product keys enabled for this workspace: jobs | analytics | employees
  enabledProducts String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    WorkspaceMember[]
  teamInvites WorkspaceInvite[]
  interviews Interview[]
  jobs       Job[]
  employees  Employee[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(RECRUITER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String                @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole         @default(RECRUITER)
  token       String                @unique
  status      WorkspaceInviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model Interview {
  id              String          @id @default(cuid())
  workspaceId     String
  ownerId         String
  jobId           String?
  title           String
  status          InterviewStatus @default(DRAFT)
  welcomeMessage  String?
  deadlineDays    Int             @default(7)
  allowRetakes    Boolean         @default(true)
  autoTranscripts Boolean         @default(true)
  requireIdCheck  Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  publishedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("InterviewOwner", fields: [ownerId], references: [id])
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  questions Question[]
  invites   Invite[]
}

model Question {
  id          String @id @default(cuid())
  interviewId String
  order       Int
  text        String
  timeLimitSec Int   @default(120)
  retakes     Int    @default(2)
  thinkTimeSec Int   @default(0)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@unique([interviewId, order])
}

model Invite {
  id          String       @id @default(cuid())
  interviewId String
  token       String       @unique @default(cuid())
  email       String?
  candidateName String?
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  interview Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  response  CandidateResponse?
  jobApplication JobApplication?
}

model CandidateResponse {
  id          String         @id @default(cuid())
  inviteId    String         @unique
  stage       CandidateStage @default(TO_REVIEW)
  decision    CandidateDecision?
  overallRating Int?
  notes       String?
  submittedAt DateTime?
  progressPhase String @default("intro")
  currentQuestionIndex Int @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invite  Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  answers Answer[]
  rubricRatings RubricRating[]
}

model Answer {
  id           String   @id @default(cuid())
  responseId   String
  questionId   String
  videoUrl     String?
  durationSec  Int?
  transcript   String?
  retakesUsed  Int      @default(0)
  createdAt    DateTime @default(now())

  response CandidateResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model RubricRating {
  id         String @id @default(cuid())
  responseId String
  criterion  String
  rating     Int

  response CandidateResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, criterion])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  teamSize  String?
  message   String
  createdAt DateTime @default(now())
}

model Job {
  id                  String    @id @default(cuid())
  workspaceId         String
  ownerId             String
  title               String
  department          String
  employmentType      String
  location            String
  salaryRange         String?
  aboutRole           String
  duties              String
  status              JobStatus @default(DRAFT)
  publicSlug          String?   @unique
  listOnCareersPage   Boolean   @default(false)
  applicationDeadline DateTime?
  resumeEnabled       Boolean   @default(true)
  portfolioEnabled    Boolean   @default(true)
  phoneEnabled        Boolean   @default(false)
  customQuestions     Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  publishedAt         DateTime?
  closedAt            DateTime?

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User             @relation("JobOwner", fields: [ownerId], references: [id])
  applications JobApplication[]
  interviews   Interview[]
}

model JobApplication {
  id            String           @id @default(cuid())
  jobId         String
  name          String
  email         String
  resumeUrl     String?
  portfolioUrl  String?
  phone         String?
  customAnswers Json             @default("{}")
  stage         ApplicationStage @default(APPLIED)
  submittedAt   DateTime         @default(now())
  inviteId      String?          @unique
  inviteSentAt  DateTime?
  interviewId   String?
  respondBy     DateTime?
  senderUserId  String?

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invite  Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([jobId, email])
  @@index([jobId, stage])
}

model Employee {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}
